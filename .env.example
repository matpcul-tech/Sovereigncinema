# Anthropic API key. Plans the shot list and story bible.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# fal.ai key. Renders stills (default fal-ai/flux/dev), clips (LTX-2.5) and the stitched cut.
# https://fal.ai/dashboard/keys
FAL_KEY=

# Optional: override the planner model. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional: any fal text-to-image endpoint that accepts { prompt, image_size }.
# FAL_IMAGE_MODEL=fal-ai/flux/dev

# Postgres connection string (Neon, Vercel Postgres, Supabase, local).
DATABASE_URL=

# Single-user sign-in password and the secret that signs the session cookie.
# Generate the secret with: openssl rand -base64 32
APP_PASSWORD=
APP_SESSION_SECRET=

# Working title. Rename the product here.
NEXT_PUBLIC_APP_NAME=Sovereign Cinema
